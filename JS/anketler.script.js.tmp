// ========== DOM HAZIR OLDU─ŞUNDA ├çALI┼ŞACAK KODLAR ==========
document.addEventListener("DOMContentLoaded", function () {
  console.log("Sayfa y├╝klendi, JavaScript ba┼şlat─▒l─▒yor...");

  // Cihaz hover destekliyor mu? (Masa├╝st├╝) -> hover, Aksi (Mobil/Touch) -> click
  const isHoverable = window.matchMedia("(hover:hover) and (pointer:fine)").matches;

  const dropdowns = document.querySelectorAll(".nav-dropdown");

  dropdowns.forEach((dd) => {
    const toggle = dd.querySelector(".nav-dropdown-toggle");
    const menu = dd.querySelector(".nav-dropdown-menu");
    if (!toggle || !menu) return;

    if (isHoverable) {
      // Masa├╝st├╝: hover ile a├ğ─▒lacak. T─▒klama yeni sayfa a├ğmas─▒n.
      toggle.addEventListener("click", (e) => e.preventDefault());
      // (Hover i┼şi CSS ile; burada ekstra JS ┼şart de─şil ama tutarl─▒l─▒k i├ğin aktif s─▒n─▒f─▒ y├Ânetebiliriz)
      dd.addEventListener("mouseenter", () => dd.classList.add("active"));
      dd.addEventListener("mouseleave", () => dd.classList.remove("active"));
    } else {
      // Mobil/Touch: t─▒klama ile a├ğ/kapat
      toggle.addEventListener("click", function (e) {
        e.preventDefault();
        e.stopPropagation();
        // Di─şer a├ğ─▒k men├╝leri kapat
        dropdowns.forEach((other) => {
          if (other !== dd) other.classList.remove("active");
        });
        // Bu men├╝y├╝ a├ğ/kapat
        dd.classList.toggle("active");
      });
    }
  });

  // D─▒┼şar─▒ t─▒klamada kapat
  document.addEventListener("click", function (e) {
    dropdowns.forEach((dd) => {
      if (!dd.contains(e.target)) dd.classList.remove("active");
    });
  });

  // ESC ile kapat
  document.addEventListener("keydown", function (e) {
    if (e.key === "Escape") dropdowns.forEach((dd) => dd.classList.remove("active"));
  });

  /* --- Profil men├╝s├╝, arama, filtre vb. mevcut kodlar─▒n aynen kalabilir --- */

  // ========== PROF─░L DROPDOWN S─░STEM─░ ==========
  const profileBtn = document.getElementById("profileBtn");
  const profileMenu = document.getElementById("profileMenu");

  if (profileBtn && profileMenu) {
    console.log("Profil buton ve men├╝ bulundu");

    // Profil butonuna t─▒klama
    profileBtn.addEventListener("click", function (e) {
      console.log("Profil butonuna t─▒kland─▒");
      e.preventDefault();
      e.stopPropagation();

      // Navbar dropdown'─▒n─▒ kapat
      if (navDropdown) {
        navDropdown.classList.remove("active");
      }

      // Profil men├╝s├╝n├╝ a├ğ/kapat
      profileMenu.classList.toggle("show");
      profileBtn.classList.toggle("active");

      console.log("Profil men├╝ durumu:", profileMenu.classList.contains("show"));
    });

    // Sayfa herhangi bir yerine t─▒kland─▒─ş─▒nda men├╝y├╝ kapat
    document.addEventListener("click", function (e) {
      if (!profileBtn.contains(e.target) && !profileMenu.contains(e.target)) {
        profileMenu.classList.remove("show");
        profileBtn.classList.remove("active");
      }
    });

    // Profil men├╝ item'lar─▒na t─▒klama
    const profileMenuItems = profileMenu.querySelectorAll(".profile-menu-item");
    profileMenuItems.forEach((item) => {
      item.addEventListener("click", function (e) {
        e.preventDefault();
        console.log("Profil men├╝ item t─▒kland─▒:", this.textContent.trim());

        // ├ç─▒k─▒┼ş yap butonuna ├Âzel i┼şlem
        if (this.classList.contains("logout")) {
          if (confirm("├ç─▒k─▒┼ş yapmak istedi─şinizden emin misiniz?")) {
            console.log("├ç─▒k─▒┼ş yap─▒l─▒yor...");
            // window.location.href = '/logout'; // Ger├ğek uygulamada kullan─▒l─▒r
            alert("├ç─▒k─▒┼ş i┼şlemi sim├╝lasyonu - Ger├ğek uygulamada y├Ânlendirme yap─▒lacak");
          }
        } else {
          // Di─şer men├╝ itemlar─▒ i├ğin i┼şlem
          alert("Bu ├Âzellik hen├╝z aktif de─şil: " + this.textContent.trim());
        }

        // Men├╝y├╝ kapat
        profileMenu.classList.remove("show");
        profileBtn.classList.remove("active");
      });
    });

    // ESC tu┼şu ile men├╝y├╝ kapat
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") {
        profileMenu.classList.remove("show");
        profileBtn.classList.remove("active");
      }
    });
  } else {
    console.log("Profil buton veya men├╝ bulunamad─▒");
    console.log("profileBtn:", profileBtn);
    console.log("profileMenu:", profileMenu);
  }

  // ========== ARAMA FONKS─░YONU ==========
  const searchInput = document.getElementById("searchInput");
  if (searchInput) {
    console.log("Arama input bulundu");

    searchInput.addEventListener("input", function (e) {
      const searchTerm = e.target.value.toLowerCase();
      const surveyItems = document.querySelectorAll(".survey-item");
      let hasResults = false;

      console.log("Arama yap─▒l─▒yor:", searchTerm);

      surveyItems.forEach((item) => {
        const title = item.querySelector(".survey-title");
        const desc = item.querySelector(".survey-desc");

        if (title && desc) {
          const titleText = title.textContent.toLowerCase();
          const descText = desc.textContent.toLowerCase();

          if (titleText.includes(searchTerm) || descText.includes(searchTerm)) {
            item.style.display = "block";
            hasResults = true;
          } else {
            item.style.display = "none";
          }
        }
      });

      // Bo┼ş durum mesaj─▒n─▒ g├Âster/gizle
      const emptyState = document.getElementById("emptyState");
      if (emptyState) {
        if (!hasResults && searchTerm !== "") {
          emptyState.classList.remove("d-none");
        } else {
          emptyState.classList.add("d-none");
        }
      }
    });
  } else {
    console.log("Arama input bulunamad─▒");
  }

  // ========== YEN─░ F─░LTRE TAB S─░STEM─░ ==========
  const filterTabs = document.querySelectorAll(".filter-tab");
  if (filterTabs.length > 0) {
    console.log("Filtre tablar─▒ bulundu:", filterTabs.length);

    filterTabs.forEach((tab) => {
      tab.addEventListener("click", function () {
        console.log("Filtre tab t─▒kland─▒:", this.getAttribute("data-filter"));

        // Aktif filtre tab─▒n─▒ g├╝ncelle
        filterTabs.forEach((t) => t.classList.remove("active"));
        this.classList.add("active");

        const filter = this.getAttribute("data-filter");
        const surveyItems = document.querySelectorAll(".survey-item");
        let hasResults = false;

        surveyItems.forEach((item) => {
          const category = item.getAttribute("data-category");
          if (filter === "all" || category === filter) {
            item.style.display = "block";
            hasResults = true;
          } else {
            item.style.display = "none";
          }
        });

        // Bo┼ş durum mesaj─▒n─▒ g├Âster/gizle
        const emptyState = document.getElementById("emptyState");
        if (emptyState) {
          if (!hasResults) {
            emptyState.classList.remove("d-none");
          } else {
            emptyState.classList.add("d-none");
          }
        }
      });
    });
  } else {
    console.log("Filtre tablar─▒ bulunamad─▒");
  }

  // ========== B─░LD─░R─░M S─░STEM─░ ==========
  const notificationBell = document.querySelector(".notification-bell");
  if (notificationBell) {
    console.log("Bildirim bell bulundu");

    notificationBell.addEventListener("click", function () {
      console.log("Bildirim t─▒kland─▒");
      alert(
        "3 yeni bildiriminiz var:\nÔÇó Yeni anket: Personel Memnuniyet Anketi\nÔÇó Anket hat─▒rlatmas─▒: E─şitim ─░htiya├ğ Analizi\nÔÇó Sonu├ğlar haz─▒r: ─░┼ş Ortam─▒ De─şerlendirme"
      );
    });
  }

  // ========== ANKET KARTLARI ─░NTERAKS─░YONU ==========
  const surveyBtns = document.querySelectorAll(".survey-btn");
  surveyBtns.forEach((btn) => {
    btn.addEventListener("click", function (e) {
      e.preventDefault();
      console.log("Anket butonu t─▒kland─▒");

      if (this.classList.contains("completed")) {
        alert("Anket sonu├ğlar─▒ g├Âr├╝nt├╝leniyor...");
      } else if (this.classList.contains("expired")) {
        alert("Bu anketin s├╝resi dolmu┼ştur.");
      } else {
        alert("Ankete y├Ânlendiriliyor...");
      }
    });
  });

  // ========== SIRALAMA S─░STEM─░ ==========
  const sortSelect = document.querySelector(".sort-select");
  if (sortSelect) {
    console.log("S─▒ralama select bulundu");

    sortSelect.addEventListener("change", function (e) {
      const sortType = e.target.value;
      console.log("S─▒ralama se├ğildi:", sortType);

      const surveyContainer = document.getElementById("surveyContainer");
      const surveyItems = Array.from(surveyContainer.querySelectorAll(".survey-item"));

      // S─▒ralama i┼şlemi
      surveyItems.sort((a, b) => {
        switch (sortType) {
          case "En Yeni":
            return sortByDate(a, b, false); // Yeniden eskiye
          case "En Eski":
            return sortByDate(a, b, true); // Eskiden yeniye
          case "Pop├╝lerlik":
            return sortByPopularity(a, b);
          default:
            return sortByDate(a, b, false); // Varsay─▒lan: En yeni
        }
      });

      // S─▒ralanm─▒┼ş ├Â─şeleri DOM'a tekrar ekle
      surveyItems.forEach((item) => {
        surveyContainer.appendChild(item);
      });

      // Smooth scroll efekti
      surveyContainer.style.opacity = "0.7";
      setTimeout(() => {
        surveyContainer.style.opacity = "1";
      }, 150);
    });
  } else {
    console.log("S─▒ralama select bulunamad─▒");
  }

  console.log("T├╝m JavaScript event listener'lar─▒ ba┼şar─▒yla y├╝klendi");
});

// ========== FAVOR─░ TOGGLE FONKS─░YONU (GLOBAL) ==========
function toggleFavorite(btn) {
  console.log("Favori toggle ├ğa─şr─▒ld─▒");

  const icon = btn.querySelector("i");
  const textNodes = Array.from(btn.childNodes).filter((node) => node.nodeType === Node.TEXT_NODE);

  if (icon) {
    if (icon.classList.contains("far")) {
      // Favoriye ekle
      icon.classList.remove("far");
      icon.classList.add("fas");
      btn.classList.remove("btn-outline-warning");
      btn.classList.add("btn-warning");

      // Text node'u g├╝ncelle
      textNodes.forEach((node) => {
        if (node.textContent.trim().includes("Favoriye Ekle")) {
          node.textContent = " Favorilerden ├ç─▒kar";
        }
      });

      console.log("Favoriye eklendi");
    } else {
      // Favorilerden ├ğ─▒kar
      icon.classList.remove("fas");
      icon.classList.add("far");
      btn.classList.remove("btn-warning");
      btn.classList.add("btn-outline-warning");

      // Text node'u g├╝ncelle
      textNodes.forEach((node) => {
        if (node.textContent.trim().includes("Favorilerden ├ç─▒kar")) {
          node.textContent = " Favoriye Ekle";
        }
      });

      console.log("Favorilerden ├ğ─▒kar─▒ld─▒");
    }
  }
}

// ========== SIRALAMA YARDIMCI FONKS─░YONLARI ==========

// Tarihe g├Âre s─▒ralama
function sortByDate(a, b, ascending = true) {
  const dateA = extractDate(a);
  const dateB = extractDate(b);

  if (!dateA || !dateB) return 0;

  return ascending ? dateA - dateB : dateB - dateA;
}

// Pop├╝lerli─şe g├Âre s─▒ralama (kat─▒l─▒m oran─▒na g├Âre)
function sortByPopularity(a, b) {
  const participationA = extractParticipation(a);
  const participationB = extractParticipation(b);

  return participationB - participationA; // Y├╝ksekten d├╝┼ş├╝─şe
}

// Anket kart─▒ndan tarihi ├ğ─▒kar
function extractDate(surveyItem) {
  const dateElement = surveyItem.querySelector(".survey-date");
  if (!dateElement) return null;

  const dateText = dateElement.textContent;
  // Tarih format─▒: "09.10.2024 - 15.11.2024"
  const dateMatch = dateText.match(/(\d{2})\.(\d{2})\.(\d{4})/);

  if (dateMatch) {
    const [, day, month, year] = dateMatch;
    return new Date(year, month - 1, day); // JavaScript aylar─▒ 0-11 aras─▒
  }

  return null;
}

// Kat─▒l─▒m oran─▒n─▒ ├ğ─▒kar
function extractParticipation(surveyItem) {
  const participationElement = surveyItem.querySelector(".participation-rate");
  if (!participationElement) return 0;

  const participationText = participationElement.textContent;
  // Format: "Kat─▒l─▒m: 45/120 ki┼şi" veya "%37"

  // Y├╝zde de─şerini ara
  const percentMatch = participationText.match(/(\d+)%/);
  if (percentMatch) {
    return parseInt(percentMatch[1]);
  }

  // Oran de─şerini ara (45/120)
  const ratioMatch = participationText.match(/(\d+)\/(\d+)/);
  if (ratioMatch) {
    const [, current, total] = ratioMatch;
    return Math.round((parseInt(current) / parseInt(total)) * 100);
  }

  return 0;
}

// ========== YARDIMCI FONKS─░YONLAR ==========
// Smooth scroll fonksiyonu
function smoothScrollTo(element) {
  if (element) {
    element.scrollIntoView({
      behavior: "smooth",
      block: "start",
    });
  }
}

// Loading state g├Âsterme
function showLoading(element) {
  if (element) {
    element.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Y├╝kleniyor...';
    element.disabled = true;
  }
}

// Loading state gizleme
function hideLoading(element, originalText) {
  if (element) {
    element.innerHTML = originalText;
    element.disabled = false;
  }
}

// Toast mesaj g├Âsterme (Bootstrap kullanarak)
function showToast(message, type = "info") {
  const toastHTML = `
        <div class="toast align-items-center text-white bg-${type} border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body">
                    ${message}
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
        </div>
    `;

  // Toast container'─▒ olu┼ştur (yoksa)
  let toastContainer = document.querySelector(".toast-container");
  if (!toastContainer) {
    toastContainer = document.createElement("div");
    toastContainer.className = "toast-container position-fixed bottom-0 end-0 p-3";
    document.body.appendChild(toastContainer);
  }

  // Toast'─▒ ekle
  const tempDiv = document.createElement("div");
  tempDiv.innerHTML = toastHTML.trim();
  const toastElement = tempDiv.firstChild;

  toastContainer.appendChild(toastElement);

  // Bootstrap Toast'─▒ ba┼şlat
  const toast = new bootstrap.Toast(toastElement, {
    autohide: true,
    delay: 5000,
  });

  toast.show();

  // Temizleme i├ğin event listener
  toastElement.addEventListener("hidden.bs.toast", function () {
    toastElement.remove();
  });
}
document.addEventListener("DOMContentLoaded", function () {
  // --- Gerekli B├╝t├╝n HTML Elementlerini Se├ğme ---
  const profileBtn = document.getElementById("profileBtn");
  const profileMenu = document.getElementById("profileMenu");
  const menuToggleBtn = document.querySelector(".mobile-menu-toggle");
  const sideMenu = document.getElementById("sideMenu");
  const closeMenuBtn = document.querySelector(".close-menu-btn");
  const menuBackdrop = document.getElementById("menuBackdrop");
  const navDropdown = document.querySelector(".nav-dropdown");
  const dropdownToggle = document.querySelector(".nav-dropdown-toggle");

  // --- MOB─░L YAN MEN├£ S─░STEM─░ ---
  if (menuToggleBtn && sideMenu && closeMenuBtn && menuBackdrop) {
    // Men├╝y├╝ a├ğ
    menuToggleBtn.addEventListener("click", function () {
      sideMenu.classList.add("active");
      menuBackdrop.classList.add("active");
    });

    // Men├╝y├╝ kapat (X butonu ile)
    closeMenuBtn.addEventListener("click", function () {
      sideMenu.classList.remove("active");
      menuBackdrop.classList.remove("active");
    });

    // Men├╝y├╝ kapat (arka plana t─▒klayarak)
    menuBackdrop.addEventListener("click", function () {
      sideMenu.classList.remove("active");
      menuBackdrop.classList.remove("active");
    });
  }

  // --- PROF─░L A├çILIR MEN├£ S─░STEM─░ ---
  if (profileBtn && profileMenu) {
    profileBtn.addEventListener("click", function (e) {
      e.stopPropagation();
      if (navDropdown) navDropdown.classList.remove("active"); // Di─şer men├╝y├╝ kapat
      profileMenu.classList.toggle("show");
      profileBtn.classList.toggle("active");
    });
  }

  // --- MASA├£ST├£ NAVBAR A├çILIR MEN├£ S─░STEM─░ ---
  if (navDropdown && dropdownToggle) {
    dropdownToggle.addEventListener("click", function (e) {
      e.preventDefault(); // Sayfan─▒n en ├╝st├╝ne gitmesini engelle
      e.stopPropagation();
      if (profileMenu) profileMenu.classList.remove("show"); // Di─şer men├╝y├╝ kapat
      navDropdown.classList.toggle("active");
    });
  }

  // --- Sayfada Bo┼ş Bir Yere veya ESC Tu┼şuna Bas─▒nca Men├╝leri Kapat ---
  document.addEventListener("click", function (e) {
    if (profileMenu && !profileBtn.contains(e.target) && !profileMenu.contains(e.target)) {
      profileMenu.classList.remove("show");
      profileBtn.classList.remove("active");
    }
    if (navDropdown && !navDropdown.contains(e.target)) {
      navDropdown.classList.remove("active");
    }
  });

  document.addEventListener("keydown", function (e) {
    if (e.key === "Escape") {
      if (profileMenu) {
        profileMenu.classList.remove("show");
        profileBtn.classList.remove("active");
      }
      if (navDropdown) navDropdown.classList.remove("active");
      if (sideMenu) {
        sideMenu.classList.remove("active");
        menuBackdrop.classList.remove("active");
      }
    }
  });
});
document.addEventListener("DOMContentLoaded", () => {
  const dropdowns = document.querySelectorAll(".nav-dropdown");

  const setArrow = (li) => {
    const toggle = li.querySelector(".nav-dropdown-toggle");
    const menu = li.querySelector(".nav-dropdown-menu");
    if (!toggle || !menu) return;

    // Men├╝ g├Âr├╝nm├╝yorsa ├Âl├ğ├╝m i├ğin anl─▒k g├Âr├╝n├╝r yap
    const cs = getComputedStyle(menu);
    const hidden = cs.display === "none" || cs.visibility === "hidden" || cs.opacity === "0";
    if (hidden) {
      menu.style.visibility = "hidden";
      menu.style.display = "block";
    }

    const t = toggle.getBoundingClientRect();
    const m = menu.getBoundingClientRect();
    const center = t.left + t.width / 2 - m.left; // toggle merkezi ÔåÆ men├╝ye g├Âre
    menu.style.setProperty("--arrow-left", `${center}px`);

    if (hidden) {
      menu.style.display = "";
      menu.style.visibility = "";
    }
  };

  dropdowns.forEach((li) => {
    li.addEventListener("mouseenter", () => setArrow(li));
    li.addEventListener("focusin", () => setArrow(li));
  });

  // pencere boyutu de─şi┼şirse yeniden hizala
  window.addEventListener("resize", () => {
    document
      .querySelectorAll(".nav-dropdown:hover, .nav-dropdown:focus-within")
      .forEach((li) => setArrow(li));
  });
});
document.addEventListener("DOMContentLoaded", () => {
  const dropdowns = document.querySelectorAll(".nav-dropdown");

  const alignMenuToCenter = (menuItem) => {
    const menu = menuItem.querySelector(".nav-dropdown-menu");
    const toggle = menuItem.querySelector(".nav-dropdown-toggle");
    if (!menu || !toggle) return;

    // Ekran─▒n ve ba┼şl─▒─ş─▒n merkezini hesapla
    const screenCenter = window.innerWidth / 2;
    const toggleRect = toggle.getBoundingClientRect();
    const toggleCenter = toggleRect.left + toggleRect.width / 2;

    // Ba┼şl─▒k ekran─▒n solunda m─▒ sa─ş─▒nda m─▒ diye kontrol et
    if (toggleCenter < screenCenter) {
      // SOLDA: Men├╝y├╝ sa─şa do─şru a├ğ
      menu.classList.add("pull-right");
      menu.classList.remove("pull-left");
    } else {
      // SA─ŞDA: Men├╝y├╝ sola do─şru a├ğ
      menu.classList.add("pull-left");
      menu.classList.remove("pull-right");
    }
  };

  // Her men├╝n├╝n ├╝zerine gelince hizalama fonksiyonunu ├ğal─▒┼şt─▒r
  dropdowns.forEach((item) => {
    item.addEventListener("mouseenter", () => alignMenuToCenter(item));
  });
});
